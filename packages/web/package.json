{
  "name": "@sticker-pop/web",
  "version": "0.1.0",
  "description": "Sticker Pop for the web: a bold, sticker-style design system. CSS tokens and components, small behaviour scripts, formatters and charts.",
  "keywords": [
    "design-system",
    "css",
    "ui",
    "components",
    "design-tokens",
    "sticker-pop"
  ],
  "license": "MIT",
  "homepage": "https://stupidly-logical.github.io/sticker-pop/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stupidly-logical/sticker-pop.git",
    "directory": "packages/web"
  },
  "bugs": "https://github.com/stupidly-logical/sticker-pop/issues",
  "type": "module",
  "main": "src/tokens.mjs",
  "types": "src/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./src/tokens.d.ts",
      "default": "./src/tokens.mjs"
    },
    "./sticker-pop.css": "./src/sticker-pop.css",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./fills.css": "./src/fills.css",
    "./tokens.mjs": {
      "types": "./src/tokens.d.ts",
      "default": "./src/tokens.mjs"
    },
    "./format": {
      "types": "./src/format.d.ts",
      "default": "./src/format.mjs"
    },
    "./format.mjs": {
      "types": "./src/format.d.ts",
      "default": "./src/format.mjs"
    },
    "./behaviors": "./src/behaviors.mjs",
    "./behaviors.mjs": "./src/behaviors.mjs",
    "./charts": "./src/charts.mjs",
    "./charts.mjs": "./src/charts.mjs",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "fonts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "gallery": "python3 -m http.server 4173",
    "test": "node scripts/test-format.mjs"
  }
}
